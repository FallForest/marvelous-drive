# Copy to .env and fill in the secrets. docker compose reads this file.
#
# Nothing here is required for a local run: without it the drive starts on
# 127.0.0.1:4400 with a generated JWT secret and no update checking.

# ── basics ───────────────────────────────────────────────────────────
DRIVE_PORT=4400
# Generate with: openssl rand -hex 32
JWT_SECRET=
# One request, in bytes. 2 GiB here.
DRIVE_MAX_UPLOAD_BYTES=2147483648
# Per-account ceiling in bytes; 0 = unlimited. Keep it comfortably under the data
# volume's free space: the blobs, the SQLite snapshot an update takes and the
# upload spool all live there.
#
# The number is bytes, and the client divides by 1024 while labelling the result
# GB, so 150000000000 renders as "140 GB" — the same quantity df calls 139.7 GiB.
# Pick bytes, then read the rendered figure; do not assume the field is GB.
DRIVE_QUOTA_BYTES=0

# ── release / self-update ────────────────────────────────────────────
# Empty DRIVE_IMAGE means "build locally", which is what a clone does.
DRIVE_IMAGE=
DRIVE_VERSION=

# The manifest the account menu checks. Leave empty to read the committed
# release/latest.json (right for a private repo, where the release asset URL
# answers 404 anonymously); otherwise point it at the release asset.
DRIVE_UPDATE_MANIFEST_URL=
# Only for a manifest that needs auth (a private repository + the asset URL).
DRIVE_UPDATE_MANIFEST_TOKEN=

# The updater container. The token is the shared secret between the API and the
# agent; generate one with: openssl rand -hex 32
DRIVE_UPDATE_AGENT_URL=http://updater:8080
DRIVE_UPDATE_AGENT_TOKEN=

# ── storage (optional) ───────────────────────────────────────────────
# local | s3 | tiered | cluster — see docs/STORAGE.md and docs/CLUSTER.md
DRIVE_STORAGE=local
DRIVE_S3_ENDPOINT=
DRIVE_S3_BUCKET=
DRIVE_S3_REGION=us-east-1
DRIVE_S3_ACCESS_KEY_ID=
DRIVE_S3_SECRET_ACCESS_KEY=