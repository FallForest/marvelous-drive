# Copy to .env and fill in the secrets. docker compose reads this file.
#
# Nothing here is required for a local run: without it the drive starts on
# 127.0.0.1:4400 with a generated JWT secret and no update checking.

# ── basics ───────────────────────────────────────────────────────────
DRIVE_PORT=4400
# Generate with: openssl rand -hex 32
JWT_SECRET=
DRIVE_MAX_UPLOAD_BYTES=2147483648

# ── release / self-update ────────────────────────────────────────────
# Empty DRIVE_IMAGE means "build locally", which is what a clone does.
DRIVE_IMAGE=
DRIVE_VERSION=

# The manifest published with each GitHub release. Point this at the release
# asset so the account menu can tell you a newer version exists.
DRIVE_UPDATE_MANIFEST_URL=

# The updater container. The token is the shared secret between the API and the
# agent; generate one with: openssl rand -hex 32
DRIVE_UPDATE_AGENT_URL=http://updater:8080
DRIVE_UPDATE_AGENT_TOKEN=

# ── storage (optional) ───────────────────────────────────────────────
# local | s3 | tiered | cluster — see docs/STORAGE.md and docs/CLUSTER.md
DRIVE_STORAGE=local
DRIVE_S3_ENDPOINT=
DRIVE_S3_BUCKET=
DRIVE_S3_REGION=us-east-1
DRIVE_S3_ACCESS_KEY_ID=
DRIVE_S3_SECRET_ACCESS_KEY=
