{
  "name": "marvelous-drive",
  "private": true,
  "version": "0.19.0",
  "type": "module",
  "description": "Self-hosted cloud drive with a web client, a CLI and a content-addressed blob store.",
  "engines": {
    "node": ">=22.5"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "start": "node apps/server/src/index.js",
    "dev": "node --watch apps/server/src/index.js",
    "test": "node --test \"apps/server/test/*.test.js\" \"packages/cli/test/*.test.mjs\" \"apps/web/test/*.test.js\"",
    "test:server": "node --test \"apps/server/test/*.test.js\"",
    "test:cli": "node --test \"packages/cli/test/*.test.mjs\"",
    "test:web": "node --test \"apps/web/test/*.test.js\"",
    "check": "node scripts/check-syntax.mjs",
    "lint": "node scripts/check-syntax.mjs && node scripts/motion-lint.mjs apps/web/styles",
    "smoke": "node scripts/smoke.mjs",
    "verify": "node scripts/smoke.mjs && node scripts/motion-lint.mjs apps/web/styles",

    "browser-check": "node scripts/browser-check.mjs",
    "browser-checks": "node scripts/run-checks.mjs",
    "motion-lint": "node scripts/motion-lint.mjs apps/web/styles",
    "motion-check": "node scripts/motion-lint.mjs apps/web/styles && node scripts/feel-check.mjs",
    "backup": "node scripts/backup.mjs",
    "mdrive": "node packages/cli/bin/mdrive.mjs",
    "upload-check": "node scripts/upload-check.mjs",
    "folder-check": "node scripts/folder-check.mjs",
    "office-check": "node scripts/office-check.mjs",
    "storage-check": "node scripts/storage-check.mjs",
    "feature-check": "node scripts/feature-check.mjs",
    "versions-check": "node scripts/versions-check.mjs",
    "search-check": "node scripts/search-check.mjs",
    "s3-check": "node scripts/s3-check.mjs",
    "s3-fixture": "node scripts/s3-fixture.mjs",
    "tiered-check": "node scripts/tiered-check.mjs",
    "lock-check": "node scripts/lock-check.mjs",
    "team-check": "node scripts/team-check.mjs"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}